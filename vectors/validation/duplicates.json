   "name": "dup_identical_locktime_asserts_one_input",
   "tx": {
    "version": 2,
    "locktime": 600,
    "inputs": [
     {
      "txid": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
      "index": 0,
      "script_pubkey": "5120aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
      "amount": 1000,
      "sequence": 4294967294,
      "conditions": "ffff20ff82025880ffff20ff8202588080"
     }
    ],
    "outputs": [
     {
      "script_pubkey": "00149999999999999999999999999999999999999999",
      "amount": 500
     }
    ]
   },
   "expect": {
    "valid": true
   }
  },
